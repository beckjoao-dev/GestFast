# ═══════════════════════════════════════════════════════════════════
# GESTFAST — Variáveis de Ambiente
# Copie para .env e preencha. NUNCA suba .env para o GitHub.
# ═══════════════════════════════════════════════════════════════════

# ── Banco Supabase ───────────────────────────────────────────────
# URL com pgBouncer (porta 6543) — para o app em produção
# No Supabase: Project Settings → Database → Connection string → Transaction
DATABASE_URL="postgresql://postgres.SUAREF:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# URL direta (porta 5432) — para migrations locais (npm run db:push)
# No Supabase: Project Settings → Database → Connection string → Session
DIRECT_URL="postgresql://postgres.SUAREF:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── JWT ─────────────────────────────────────────────────────────
# Gere: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="gere-aqui-64-bytes-hexadecimais"
JWT_EXPIRES_IN="8h"

# ── App ─────────────────────────────────────────────────────────
NODE_ENV="development"
